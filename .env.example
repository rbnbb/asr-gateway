ASR_API_KEY=replace-with-a-long-random-gateway-key
ASR_BACKEND_URL=https://speaches.example.test/v1
ASR_HEALTH_URL=https://speaches.example.test/health
ASR_BACKEND_KEY=
ASR_MODEL=replace-with-your-existing-speaches-model-id
ASR_WAKE_MODE=tcp
ASR_WAKE_HOST=host.docker.internal
ASR_WAKE_PORT=9
ASR_READY_TIMEOUT=180
ASR_SYNC_TIMEOUT=180
ASR_INFERENCE_TIMEOUT=600
ASR_RETENTION=3600
ASR_WAKE_RETRY_SECONDS=10
# One browser owner account; choose a long passphrase (at least 16 characters).
ASR_BROWSER_USERNAME=owner
# Empty uses ASR_API_KEY as the browser password for backwards compatibility.
ASR_BROWSER_PASSWORD=
# Remember a browser for 30 days; requires HTTPS at Traefik.
ASR_SESSION_SECONDS=2592000
